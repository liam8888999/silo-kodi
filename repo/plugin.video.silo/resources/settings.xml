<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.video.silo" label="Silo Media Server">
    <category id="connection" label="Connection">
      <group id="1" label="Account">
        <setting id="server" type="string" label="Server address" help="The URL of your Silo server.">
          <level>0</level>
          <control type="edit" format="string" />
        </setting>
        <setting id="username" type="string" label="Username" help="Use username#profile to automatically select a profile.">
          <level>0</level>
          <control type="edit" format="string" />
        </setting>
        <setting id="profile" type="string" label="Profile name" help="Optional. Leave empty to use the normal profile selection dialog.">
          <level>0</level>
          <control type="edit" format="string" />
        </setting>

        <setting id="device_id" type="string">
          <level>4</level>
        </setting>
        <setting id="token" type="string">
          <level>4</level>
        </setting>
        <setting id="refresh_token" type="string">
          <level>4</level>
        </setting>
        <setting id="profile_id" type="string">
          <level>4</level>
        </setting>
        <setting id="profile_token" type="string">
          <level>4</level>
        </setting>
        <setting id="start_overrides" type="string">
          <level>4</level>
        </setting>
      </group>
    </category>

    <category id="pagination" label="Pagination">
      <group id="1" label="Display">
        <setting id="items_per_page" type="integer" label="Items per page" help="Number of items shown before a Next Page entry is added.">
          <level>0</level>
          <default>200</default>
          <constraints>
            <minimum>20</minimum>
            <step>10</step>
            <maximum>200</maximum>
          </constraints>
          <control type="spinner" format="integer" />
        </setting>
      </group>
    </category>
  </section>
</settings>
